{
  "name": "ratexp",
  "displayName": "RateXp",
  "version": "2.0.0",
  "description": "Type /ratexp:rate to rate the session, the most recent run of a skill, or both, on as many evals as you like, in one panel. The ratings, and the conversation when you agree, go to the RateXp dashboard.",
  "author": {
    "name": "Hikmet Beyoglu",
    "url": "https://github.com/HikmetB1"
  },
  "homepage": "https://github.com/HikmetB1/RateXp",
  "repository": "https://github.com/HikmetB1/RateXp",
  "license": "LicenseRef-RateXp-Source-Available-1.0",
  "keywords": ["feedback", "evals", "ratings", "skills"],
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/ratexp-claude.sh\""}]}
    ],
    "UserPromptExpansion": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/ratexp-claude.sh\""}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/ratexp-claude.sh\""}]}
    ],
    "PreToolUse": [
      {
        "matcher": "Skill|AskUserQuestion",
        "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/ratexp-claude.sh\""}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/ratexp-claude.sh\"", "timeout": 60}]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/ratexp-claude.sh\""}]
      }
    ]
  }
}
