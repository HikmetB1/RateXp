# cp .env.example .env - optional, every value here is also the built-in default.
# Core's write destinations live in core/.env.example.

CORE_HOST_PORT=8000
APP_HOST_PORT=8001

# Changing these on an existing stack needs `docker compose down -v`, and
# DATABASE_URL has to match them.
POSTGRES_USER=ratexp
POSTGRES_PASSWORD=ratexp
POSTGRES_DB=ratexp
DATABASE_URL=postgresql://ratexp:ratexp@db:5432/ratexp

RATEXP_PUBLIC_URL=http://localhost:8000

# Dashboard read source. A *_QUERY_URL is the apps/DQL host, not the ingest host.
# RATEXP_READ_ADAPTER=app_be_dynatrace
# DT_QUERY_URL=https://xxxxxxxx.apps.dynatrace.com
# DT_ACCESS_TOKEN=dt0s16.XXXX...
# CUSTOM_PSQL_DSN=postgresql://user:pass@host:5432/db
# CUSTOM_DT_QUERY_URL=https://xxxxxxxx.apps.dynatrace.com
# CUSTOM_DT_TOKEN=dt0s16.XXXX...
