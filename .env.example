# Local overrides for docker compose. Copy to .env (gitignored); every value
# here is also the built-in default, so an absent .env still works.
#   cp .env.example .env

# Host ports published on your machine.
CORE_HOST_PORT=8000
APP_HOST_PORT=8001

# Bundled PostgreSQL credentials (local only). Applied on first DB init; to
# change them on an existing stack, wipe the volume: docker compose down -v.
POSTGRES_USER=ratexp
POSTGRES_PASSWORD=ratexp
POSTGRES_DB=ratexp

# Connection string shared by core and app. Keep user/password in sync with the
# values above. Host is the compose service name `db`.
DATABASE_URL=postgresql://ratexp:ratexp@db:5432/ratexp

# Public base URL core hands the agent for the transcript helper + upload endpoint
# (must be reachable from the host running the skill).
RATEXP_PUBLIC_URL=http://localhost:8000

# PII redaction runs an adapter (config.yaml redaction.provider) whose deps aren't
# in the local core image, so it's off by default here. Set true only once core is
# built with a redaction adapter (presidio, or azure + Azure credentials).
RATEXP_REDACTION_ENABLED=false

# Destinations. Which adapters receive each submission is set in core/config.yaml
# (the `adapters` block). Their per-environment values come from env vars named there:
#   app_be_dynatrace / custom_dynatrace -> a Dynatrace tenant URL + token
#   custom_psql                         -> a PostgreSQL connection string
# CORE_EXTRAS builds the OpenTelemetry deps into the local core image so the
# Dynatrace adapters can run (leave empty to keep the image lean).
CORE_EXTRAS=
DT_TENANT_URL=https://xxxxxxxx.live.dynatrace.com
DT_ACCESS_TOKEN=
# CUSTOM_PSQL_DSN=postgresql://user:pass@host:5432/db
# CUSTOM_DT_TENANT_URL=https://xxxxxxxx.live.dynatrace.com
# CUSTOM_DT_TOKEN=

# Dashboard read source (app-be config.yaml read_adapters - enable exactly one; default
# app_be_psql). Mirrors the write 2x2: app_be_psql | custom_psql | app_be_dynatrace |
# custom_dynatrace. RATEXP_READ_ADAPTER overrides which; the filter box speaks its language
# (SQL for psql, DQL for dynatrace). Point *DT query URLs at the DQL/apps host (not ingest).
# RATEXP_READ_ADAPTER=app_be_dynatrace
# DT_QUERY_URL=https://xxxxxxxx.apps.dynatrace.com   # apps/DQL host (not ingest host)
# CUSTOM_DT_QUERY_URL=https://xxxxxxxx.apps.dynatrace.com
# CUSTOM_DT_TOKEN=dt0s16.XXXX...
# (custom_psql read reuses CUSTOM_PSQL_DSN above)
