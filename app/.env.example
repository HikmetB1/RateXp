# cp app/.env.example app/.env - credentials for the read source you switch on in
# config.yaml (read_adapters). Exactly one source is read from at a time.

# app_be_psql needs nothing here - it reuses DATABASE_URL.

# app_be_dynatrace - a *_QUERY_URL is the apps/DQL host, not the ingest host.
# DT_QUERY_URL=https://xxxxxxxx.apps.dynatrace.com
# DT_ACCESS_TOKEN=dt0s16.XXXX...

# custom_psql
# CUSTOM_PSQL_DSN=postgresql://user:pass@host:5432/db

# custom_dynatrace
# CUSTOM_DT_QUERY_URL=https://xxxxxxxx.apps.dynatrace.com
# CUSTOM_DT_TOKEN=dt0s16.XXXX...

# phoenix - the same three core writes with, pointed at the same project
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space
# PHOENIX_API_KEY=
# PHOENIX_PROJECT_NAME=ratexp

# Required once RATEXP_ENV is anything but "local" - the app refuses to start without it.
# RATEXP_CORS_ORIGINS=https://your-dashboard.example.com
