# cp core/.env.example core/.env - values for the destinations you switch on in
# config.yaml (write_adapters). A missing value skips that destination with a warning.

# app_be_dynatrace
DT_TENANT_URL=
DT_ACCESS_TOKEN=

# custom_psql
# CUSTOM_PSQL_DSN=postgresql://user:pass@host:5432/db

# custom_dynatrace
# CUSTOM_DT_TENANT_URL=https://xxxxxxxx.live.dynatrace.com
# CUSTOM_DT_TOKEN=dt0s16.XXXX...

# bluebox - endpoint from `bluebox otlp-endpoint`
# BLUEBOX_OTLP_ENDPOINT=https://xxxxxxxx.live.dynatrace.com/api/v2/otlp
# BLUEBOX_OTLP_TOKEN=dt0c01.XXXX...
