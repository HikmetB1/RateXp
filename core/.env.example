# cp core/.env.example core/.env - values for the destinations you switch on in
# config.yaml (write_adapters). A missing value skips that destination with a warning.

# app_be_psql needs nothing here - it reuses DATABASE_URL.

# labeling - the Azure OpenAI account (labeling.endpoint_env); reached with your az login,
# so set it only when running core with uv, never under compose
# AZURE_OPENAI_ENDPOINT=https://xxxxxxxx.openai.azure.com/

# app_be_dynatrace
DT_TENANT_URL=
DT_ACCESS_TOKEN=

# custom_psql
# CUSTOM_PSQL_DSN=postgresql://user:pass@host:5432/db

# custom_dynatrace
# CUSTOM_DT_TENANT_URL=https://xxxxxxxx.live.dynatrace.com
# CUSTOM_DT_TOKEN=dt0s16.XXXX...

# bluebox - endpoint from `bluebox otlp-endpoint`
# BLUEBOX_OTLP_ENDPOINT=https://xxxxxxxx.live.dynatrace.com/api/v2/otlp
# BLUEBOX_OTLP_TOKEN=dt0c01.XXXX...

# the environment of the records written to Dynatrace and Bluebox; the Dynatrace dashboard
# and app show one environment, and a record without it counts as prod
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev

# phoenix - the endpoint and key Phoenix shows under Settings, and the project to write into
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space
# PHOENIX_API_KEY=
# PHOENIX_PROJECT_NAME=ratexp

# dashboard publishing (python -m modules.dashboard.publish_to_dynatrace [prod|dev]) - the apps host
# and a platform token with document:documents:read + write; without it DT_ACCESS_TOKEN is used
# DT_QUERY_URL=https://xxxxxxxx.apps.dynatrace.com
# DT_DASHBOARD_TOKEN=dt0s16.XXXX...
