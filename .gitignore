# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/

# Env / secrets
.env
*.tfvars
!*.tfvars.example

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# OS / editor
.DS_Store
/.idea
/.vscode

# Shell and tool config belonging to the machine, not the repo. These appear at
# the root as empty read-only placeholders under some sandboxes. Rooted with a
# leading slash so a real file of the same name deeper in the tree still counts.
/.bashrc
/.bash_profile
/.profile
/.zshrc
/.zprofile
/.gitconfig
/.ripgreprc
/.mcp.json

# Your own ignore rules, for whatever only you have on this machine - agent files,
# recordings, scratch work. Git reads it because this repo's local config points
# at it; the notes inside the file explain the one-time setup.
.local.gitignore

# Archive (local UI style mockups, not tracked)
archive/
